<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest. Grants write access so a seeder activity can populate
  Health Connect with sample sleep/exercise records for testing the read path.
  This file is NOT part of the release build: the shipped APK remains read-only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application>
        <activity
            android:name=".SeedHealthActivity"
            android:exported="true"
            android:theme="@style/Theme.Baseline" />
    </application>
</manifest>
